@model IEnumerable<shop.Models.Receipt>
@{
    Layout = "_CashierLayout";
}


<div class="right_col" role="main">
    <div class="">
        <div class="page-title">
            <div class="title_left">
                <h3><i class="fa  fa-list"></i>  </h3>
            </div>
        </div>

        <div class="clearfix"></div>
        @if (TempData.ContainsKey("Message"))
        {
            @if (TempData["MessageState"].ToString() == "1")
            {
                <div class="alert-success " style="text-align: right;font-size: larger;"><h2> @TempData["Message"] </h2></div>
            }
            else
            {
                <div class="alert-danger " style="text-align: right;font-size: larger;"> @TempData["Message"] </div>
            }
        }
        <div class="row">
            <div class="col-md-12 col-sm-12  ">

                <div class="card">
                    <div class="card-header">
                        <a asp-action="Create" class="btn btn-outline-info  btn-flat"><i class="fa fa-plus"></i> اضافة سند </a>
                    </div>

                    <div class="card-body">
                        <div id="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
                            <div class="row"><div class="col-sm-12 col-md-6"></div><div class="col-sm-12 col-md-6"></div></div><div class="row">
                                <div class="col-sm-12">
                                    <table id="example2" class="table table-bordered table-hover dataTable dtr-inline" aria-describedby="example2_info">
                                        <thead>
                                            <tr>
                                                <th class="sorting sorting_asc" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending">رقم السند </th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Browser: activate to sort column ascending">رقم الحساب </th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Platform(s): activate to sort column ascending">المبلغ</th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Platform(s): activate to sort column ascending"> التاريخ </th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Platform(s): activate to sort column ascending">المستخدم</th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Platform(s): activate to sort column ascending">تاريخ التعديل</th>
                                                <th class="sorting" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="Platform(s): activate to sort column ascending">المستخدم</th>




                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model is not null)
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td class="dtr-control sorting_1" tabindex="0">@item.PoNumber</td>
                                                        <td>@item.AccountNumber</td>
                                                        <td>@item.Amount</td>
                                                        <td>@item.Date</td>
                                                        @*                                                        <td>@item.UserAdd.Name</td>
                                                *@
                                                        <td>@item.ModifiDate</td>
                                                        @*                                                        <td>@item.UserModifi.Name</td>
                                                *@
                                                        <td>
                                                            @*                                                        <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.Id"><i class="fa fa-eye"></i> تفاصيل</a>
                                                    *@                                                        @*<a class="btn btn-sm btn-success text-white" asp-action="Edit" asp-route-id="@item.Id"><i class="fa fa-edit"></i> تعديل</a>

                                                    <a asp-route-id="@item.Id" class="btn btn-sm btn-danger text-white" asp-action="Delete" onclick="return confirm('هل تريد الحذف بالفعل');"><i class="fa fa-trash"></i> حـــذف</a>
                                                    *@
                                                        </td>
                                                    </tr>
                                                }
                                        </tbody>
                                        @*<tfoot>
                                        <tr><th rowspan="1" colspan="1">Rendering engine</th><th rowspan="1" colspan="1">Browser</th><th rowspan="1" colspan="1">Platform(s)</th><th rowspan="1" colspan="1">Engine version</th><th rowspan="1" colspan="1">CSS grade</th></tr>
                                        </tfoot>*@


                                    </table>
                                </div>
                            </div>


                        </div>
                    </div>

                </div>


            </div>
        </div>

    </div>
</div>